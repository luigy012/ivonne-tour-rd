# ═══════════════════════════════════════════════════════════════
#  LAS LLAVES
#
#  Este archivo es SOLO EL EJEMPLO: dice qué hace falta, sin valores.
#  Los valores de verdad NO se escriben en ningún archivo del proyecto
#  — se ponen en el panel de Vercel (Settings → Environment Variables).
#
#  ⚠️ Si alguna de estas llaves acaba subida a GitHub, hay que darla de
#  baja y pedir una nueva. GitHub es público: lo que sube, se queda.
# ═══════════════════════════════════════════════════════════════

# ── DÓNDE VIVE LA WEB ─────────────────────────────────────────
# La dirección completa, sin barra al final. Azul la necesita para
# saber a dónde devolver al cliente después de pagar.
URL_BASE=https://ivonnetourrd.com

# ── AZUL (Banco Popular) ──────────────────────────────────────
# Te las dan al firmar el contrato, junto con el manual.
AZUL_MERCHANT_ID=
AZUL_MERCHANT_NAME=IVONNE TOUR RD
AZUL_MERCHANT_TYPE=Tours y excursiones
# La llave de la firma. Es la más delicada de todas.
AZUL_AUTH_KEY=
# true mientras se prueba (tarjetas de mentira, no se cobra nada).
# Se pone en false SOLO cuando todo esté probado y quieras cobrar.
AZUL_PRUEBAS=true

# ── CORREO (Resend) ───────────────────────────────────────────
# Alta en resend.com, verificar el dominio y copiar la clave.
RESEND_API_KEY=
# A dónde llegan los avisos de reservas y de pagos fallidos.
CORREO_DUENO=reservas@ivonnetourrd.com
# Quién aparece como remitente. El dominio tiene que ser el verificado.
CORREO_DESDE=IVONNE TOUR RD <reservas@ivonnetourrd.com>

# ── DÓNDE SE GUARDAN LAS RESERVAS (Upstash) ───────────────────
# Alta en upstash.com, crear una base Redis y copiar las dos.
# Sin esto funciona igual, pero guarda en memoria y se pierde al
# reiniciar: vale para probar, no para cobrar de verdad.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── WHATSAPP ──────────────────────────────────────────────────
# Sin +, sin espacios ni guiones.
WHATSAPP=18092006389
